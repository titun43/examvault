rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =============================================================================
    // ExamVault - Storage Security Rules (v3 — crash-safe)
    // =============================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
            || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
                && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // ==================== PUBLIC CONTENT IMAGES (admin-managed) ====================
    // Public read so CachedNetworkImage always loads. Admin-only write.
    match /category_images/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test_images/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banner_images/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== APP OPEN BANNER IMAGES ====================
    // Full-screen launch banner images (shown between splash and home).
    // Public read so the Flutter app's CachedNetworkImage always loads even
    // for guests (targetAudience can be 'all'/'guest'). Admin-only write
    // — uploaded via the admin panel's app-open-banners management page.
    match /app_open_banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcement_images/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /upcoming_exam_images/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /current_affairs_pdf/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== STUDY MATERIAL PDFs ====================
    // PDF files for Previous Year Papers, Study Notes, Syllabus.
    // Uploaded by admin via the Study Materials admin page. Public read so
    // the Flutter app's in-app PDF viewer can download & display them.
    // Path: study_materials/{materialId}/{filename}
    match /study_materials/{materialId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== USER AVATARS ====================
    // Each user can read/write their own avatar. Public read so avatars show
    // in leaderboards and admin views.
    match /user_avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // ==================== USER PHOTOS (profile photos) ====================
    match /user_photos/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /user_photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // ==================== CATCH-ALL (default deny) ====================
    // Anything not explicitly allowed above is denied. This is the safe
    // default but still lets the explicit rules above work.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
