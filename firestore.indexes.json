# =============================================================================
# ExamVault - Firestore Indexes
# Required composite indexes for queries
# =============================================================================

# Index for: getTestsStream(subjectId, isPublished, orderBy createdAt)
- collectionGroup: tests
  fields:
    - fieldPath: subjectId
      order: ASCENDING
    - fieldPath: isPublished
      order: ASCENDING
    - fieldPath: createdAt
      order: DESCENDING

# Index for: getTestsStream(type, isPublished, orderBy createdAt)
- collectionGroup: tests
  fields:
    - fieldPath: type
      order: ASCENDING
    - fieldPath: isPublished
      order: ASCENDING
    - fieldPath: createdAt
      order: DESCENDING

# Index for: getUserResultsStream(userId, orderBy attemptedAt)
- collectionGroup: results
  fields:
    - fieldPath: userId
      order: ASCENDING
    - fieldPath: attemptedAt
      order: DESCENDING

# Index for: getNotificationsStream(userId in [all, current], orderBy createdAt)
- collectionGroup: notifications
  fields:
    - fieldPath: userId
      order: ASCENDING
    - fieldPath: createdAt
      order: DESCENDING

# Index for: getLeaderboardStream(type, orderBy rank)
- collectionGroup: leaderboard
  fields:
    - fieldPath: type
      order: ASCENDING
    - fieldPath: rank
      order: ASCENDING

# Index for: getCurrentAffairsStream(date range)
- collectionGroup: current_affairs
  fields:
    - fieldPath: date
      order: DESCENDING
