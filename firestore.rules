rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================================
    // ExamVault - Firestore Security Rules (v3 — crash-safe, login-friendly)
    // =============================================================================
    // Design goal: NEVER block a legitimate read during the login flow or home
    // screen render. A permission-denied error on a stream that the UI doesn't
    // expect can crash the app in release mode. Public content collections are
    // fully public-read. User-specific collections are owner-read.
    // =============================================================================

    // Helper: is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is the user an admin?
    // Two paths (OR'd so admin bootstrap is resilient):
    //   1. admins/{uid} doc exists
    //   2. users/{uid}.role == 'admin'
    function isAdmin() {
      return isSignedIn()
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Helper: does the user own this document?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==================== USERS ====================
    // Owner can read/create/update own doc. Admin can read/update all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ---- BOOKMARKS subcollection ----
      // Each doc is keyed by testId. Only the owner can read/write their bookmarks.
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==================== ADMINS ====================
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update, delete: if isAdmin();
    }

    // ==================== PUBLIC CONTENT (admin-managed) ====================
    // All of these are fully public-read so the home screen never gets a
    // permission error. Only admins can write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /current_affairs/{affairId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /upcoming_exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== STUDY MATERIALS (PDF content) ====================
    // Admin-managed PDF content (Previous Year Papers, Study Notes, Syllabus).
    // Public-read so the Flutter app shows content without auth errors.
    // Only admins can create/edit/delete. isPublished filter is enforced
    // client-side (the Flutter app queries with where('isPublished','==',true)).
    match /study_materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== APP OPEN BANNERS ====================
    // Full-screen promotional banner shown once per app launch (between splash
    // and home). Public-read so the Flutter app (guests included) can fetch
    // the active banner without auth errors. Only admins can create/edit/
    // delete. The Flutter app increments impressionCount & clickCount via
    // FieldValue.increment(1) from NON-admin users — so we split the update
    // permission: admins can update any field; any client may update ONLY
    // the two counter fields (nothing else). This matches the pattern used
    // by /notifications above (allow toggle isRead by any signed-in user).
    match /app_open_banners/{bannerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys.hasOnly(['impressionCount', 'clickCount']);
    }

    match /premium_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboard/{leaderboardId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // ==================== RESULTS ====================
    match /results/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // ==================== SUBSCRIPTIONS ====================
    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ==================== PAYMENTS ====================
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ==================== TEST PURCHASES ====================
    match /test_purchases/{purchaseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // ==================== NOTIFICATIONS ====================
    // IMPORTANT: notifications are public-read for any signed-in user so that
    // a missing/mismatched `userId` field on a notification doc never causes
    // a permission-denied error (which would crash the home/notifications
    // stream in release mode). Only admins write. Users can mark their own
    // or broadcast ('all') notifications as read.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Allow admin full update; allow signed-in user to only toggle isRead.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys.only(['isRead']));
    }

    // ==================== QUESTION REPORTS ====================
    // Users can create reports (when signed in). Admins can read all reports
    // and update status (resolve/dismiss/reopen). No one can delete reports
    // (preserve audit trail). The user app writes to this collection from
    // take_test_screen when a user taps "Report Question".
    match /questionReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      // No delete — keep full audit trail of all reports.
    }

    // ==================== SUPPORT TICKETS ====================
    // In-app help & support chat. A user can create/read/update ONLY their
    // own tickets. Admins can read/update ALL tickets (e.g. reply, mark
    // resolved). The messages subcollection follows the same ownership rule
    // (the ticket's userId must match the caller).
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn()
        && (isAdmin()
            || (exists(/databases/$(database)/documents/support_tickets/$(ticketId))
                && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid));
      // Any signed-in user can create a ticket on their own behalf.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // Owner can update (e.g. send follow-up, reopen). Admin can update
      // (reply preview, mark resolved). We don't allow the owner to change
      // userId — only the admin or owner-settable denormalized fields.
      allow update: if isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/support_tickets/$(ticketId))
            && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid
            // Owner cannot reassign the ticket to another user.
            && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();

      // Messages subcollection — same ownership rule via parent ticket.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (isAdmin()
              || (exists(/databases/$(database)/documents/support_tickets/$(ticketId))
                  && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid));
        // User can create messages on their own ticket; admin can create
        // messages on any ticket (admin replies).
        allow create: if isAdmin()
          || (isSignedIn()
              && exists(/databases/$(database)/documents/support_tickets/$(ticketId))
              && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }
  }
}
