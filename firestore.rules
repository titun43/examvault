rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================================
    // ExamVault - Firestore Security Rules (v3 — crash-safe, login-friendly)
    // =============================================================================
    // Design goal: NEVER block a legitimate read during the login flow or home
    // screen render. A permission-denied error on a stream that the UI doesn't
    // expect can crash the app in release mode. Public content collections are
    // fully public-read. User-specific collections are owner-read.
    // =============================================================================

    // Helper: is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is the user an admin?
    // Two paths (OR'd so admin bootstrap is resilient):
    //   1. admins/{uid} doc exists
    //   2. users/{uid}.role == 'admin'
    function isAdmin() {
      return isSignedIn()
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Helper: does the user own this document?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==================== USERS ====================
    // Owner can read/create/update own doc. Admin can read/update all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ---- BOOKMARKS subcollection ----
      // Each doc is keyed by testId. Only the owner can read/write their bookmarks.
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==================== ADMINS ====================
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update, delete: if isAdmin();
    }

    // ==================== PUBLIC CONTENT (admin-managed) ====================
    // All of these are fully public-read so the home screen never gets a
    // permission error. Only admins can write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /current_affairs/{affairId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /upcoming_exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /premium_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboard/{leaderboardId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // ==================== RESULTS ====================
    match /results/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // ==================== SUBSCRIPTIONS ====================
    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ==================== PAYMENTS ====================
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ==================== TEST PURCHASES ====================
    match /test_purchases/{purchaseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // ==================== NOTIFICATIONS ====================
    // IMPORTANT: notifications are public-read for any signed-in user so that
    // a missing/mismatched `userId` field on a notification doc never causes
    // a permission-denied error (which would crash the home/notifications
    // stream in release mode). Only admins write. Users can mark their own
    // or broadcast ('all') notifications as read.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Allow admin full update; allow signed-in user to only toggle isRead.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys.only(['isRead']));
    }
  }
}
